# The current frontend demo and S07A schema validation need no secrets.
# Fill these only when the corresponding real services are connected.
# Keep real values in ignored .env.local, never in this template.

# S07B: application connection and separate migration connection.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# S08: random secret of at least 32 characters for iron-session.
SESSION_PASSWORD=
APP_ORIGIN=http://localhost:3000

# S08/S17: independent random keys, not user passwords.
RATE_LIMIT_SECRET=
RECOVERY_CODE_PEPPER=

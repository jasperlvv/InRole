# The current frontend demo and S07A schema validation need no secrets.
# Fill these only when the corresponding real services are connected.
# Keep real values in ignored .env.local, never in this template.

# S07B: application connection and separate migration connection.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# S08: random secret of at least 32 characters for iron-session.
SESSION_PASSWORD=
APP_ORIGIN=http://localhost:3000

# S08/S17: independent random keys, not user passwords.
RATE_LIMIT_SECRET=
TRUSTED_CLIENT_IP_HEADER=
# Leave blank unless a trusted ingress strips/replaces this header.
# Supported: x-real-ip, cf-connecting-ip, x-vercel-forwarded-for.
RECOVERY_CODE_PEPPER=

# S10/S15: private persistent directory, outside public/ and the repository.
MEDIA_STORAGE_ROOT=
# Optional maintained ffprobe binary override; otherwise uses the pinned installer.
FFPROBE_PATH=
# Migration job only; application service must not receive DIRECT_URL.
DATABASE_ROLE=inrole_app
SITE_OPERATOR=Jasper Lv
SITE_CONTACT_EMAIL=jasperlvv@gmail.com

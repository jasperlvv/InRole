# Copy to deploy/.env, chmod 600; never commit it or print compose config publicly.
# DOMAIN is the canonical host without scheme/path. Do not put an IP here.
DOMAIN=
# Build a version tag from the reviewed commit, e.g. inrole:COMMIT.
INROLE_IMAGE=
# Generate separate random base64url secrets; URL passwords must be URL-safe.
BOOTSTRAP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
SESSION_PASSWORD=
RATE_LIMIT_SECRET=
RECOVERY_CODE_PEPPER=

{
  "name": "inrole",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:local:setup": "node --use-system-ca scripts/db/local.mjs setup",
    "db:local:start": "node scripts/db/local.mjs start",
    "db:local:stop": "node scripts/db/local.mjs stop",
    "db:local:status": "node scripts/db/local.mjs status",
    "db:migrate": "node scripts/db/prisma.mjs deploy",
    "db:status": "node scripts/db/prisma.mjs status",
    "db:auth:setup": "node scripts/db/setup-auth.mjs",
    "verify:s08": "node --experimental-strip-types scripts/db/verify-auth.mjs",
    "db:seed:catalog": "node --experimental-strip-types scripts/db/seed-catalog.mjs",
    "db:import:catalog": "node --experimental-strip-types scripts/db/import-catalog.mjs",
    "verify:catalog": "node --experimental-strip-types scripts/db/verify-catalog-import.mjs",
    "verify:s07b": "node scripts/db/verify.mjs",
    "verify:s07c": "node --experimental-strip-types scripts/db/verify-api.mjs",
    "verify:s07a": "prisma validate && prisma generate && node --experimental-strip-types scripts/s07a/verify-next.mjs",
    "preview:local": "node scripts/preview.mjs",
    "verify:community": "node --experimental-strip-types scripts/db/verify-community.mjs",
    "backup:verify": "node scripts/db/backup-verify.mjs",
    "verify:s16:browser": "node scripts/db/s16-browser.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "iron-session": "9.1.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
